
generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "windows"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Authentication and User Management
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(GUEST)
  tenantId      String?   // null for super admin, set for tenant users
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  
  // Guest-specific relations
  guestProfile  GuestProfile?
  bookings      Booking[]
  serviceOrders ServiceOrder[]
  
  // Staff-specific relations
  staffProfile  StaffProfile?
  assignedTasks HousekeepingTask[]
  reportedMaintenanceRequests MaintenanceRequest[] @relation("MaintenanceReporter")
  assignedMaintenanceRequests MaintenanceRequest[] @relation("MaintenanceAssignee")
  arrivalPickups              ArrivalRecord[]      @relation("ArrivalPickupStaff")
  
  @@index([tenantId])
  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Multi-tenant Core
model Tenant {
  id          String      @id @default(cuid())
  name        String
  subdomain   String      @unique
  domain      String?     @unique
  description String?
  logo        String?
  theme       Json?       // Custom branding configuration
  settings    Json?       // Tenant-specific settings
  plan        String      @default("basic")
  commissionRate Float    @default(0.04)
  isVerifiedDirect Boolean @default(false)
  amaldivesSlug String?   @unique
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users       User[]
  properties  Property[]
  bookings    Booking[]
  rooms       Room[]
  services    Service[]
  staff       StaffProfile[]
  inventory   InventoryItem[]
  reports     Report[]
  arrivals    ArrivalRecord[]
  transportOptions TransportOption[]
  departures  DepartureRecord[]
  minIBarItems      MinIBarItem[]
  logisticsOrders   LogisticsOrder[]
  logisticsInventory LogisticsInventoryItem[]
  fnbOutlets        FnBOutlet[]
  
  @@index([subdomain])
  @@index([status])
}

model Property {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  address     String
  city        String
  state       String
  country     String
  zipCode     String
  phone       String
  email       String
  website     String?
  checkInTime String   @default("15:00")
  checkOutTime String  @default("11:00")
  currency    String   @default("USD")
  timezone    String   @default("UTC")
  images      String[]
  amenities   String[]
  policies    Json?
  settings    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms       Room[]
  bookings    Booking[]
  
  @@index([tenantId])
}

// Room Management
model Room {
  id          String     @id @default(cuid())
  tenantId    String
  propertyId  String
  number      String
  name        String
  type        RoomType
  description String?
  capacity    Int
  basePrice   Float
  images      String[]
  amenities   String[]
  size        Int?       // Square footage
  bedType     String?
  status      RoomStatus @default(AVAILABLE)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  housekeepingTasks HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]
  minIBarUsages MinIBarUsage[]
  serviceOrders ServiceOrder[]
  
  @@unique([tenantId, propertyId, number])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
}

// Booking System
model Booking {
  id            String        @id @default(cuid())
  tenantId      String
  propertyId    String
  roomId        String
  guestId       String
  confirmationNumber String   @unique
  checkInDate   DateTime
  checkOutDate  DateTime
  adults        Int
  children      Int           @default(0)
  totalAmount   Float
  platformFee   Float         @default(0)
  paidAmount    Float         @default(0)
  status        BookingStatus @default(PENDING)
  source        String?       // "direct", "booking.com", etc.
  notes         String?
  specialRequests String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guest         User          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  
  payments      Payment[]
  serviceOrders ServiceOrder[]
  arrival       ArrivalRecord?
  departure     DepartureRecord?
  minIBarUsages MinIBarUsage[]
  
  @@index([tenantId])
  @@index([confirmationNumber])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@index([status])
}

// Guest Management
model GuestProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  firstName   String
  lastName    String
  phone       String?
  dateOfBirth DateTime?
  nationality String?
  address     String?
  city        String?
  state       String?
  country     String?
  zipCode     String?
  preferences Json?     // Dietary, room preferences, etc.
  loyaltyTier String?   @default("STANDARD")
  totalStays  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// Staff Management
model StaffProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  tenantId    String
  employeeId  String?
  department  String
  position    String
  permissions String[]   // Role-specific permissions
  salary      Float?
  hireDate    DateTime
  isActive    Boolean    @default(true)
  schedule    Json?      // Work schedule configuration
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clockRecords StaffClockRecord[]
  tasks       StaffTask[]
  
  @@index([tenantId])
  @@index([userId])
}

// Housekeeping Management
model HousekeepingTask {
  id          String     @id @default(cuid())
  tenantId    String
  roomId      String
  assignedTo  String?
  taskType    TaskType
  priority    Priority   @default(MEDIUM)
  description String?
  checklist   Json?      // Task checklist items
  status      TaskStatus @default(PENDING)
  scheduledDate DateTime
  completedAt DateTime?
  estimatedDuration Int? // in minutes
  actualDuration Int?   // in minutes
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  room        Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedUser User?     @relation(fields: [assignedTo], references: [id])
  
  @@index([tenantId])
  @@index([roomId])
  @@index([assignedTo])
  @@index([status])
  @@index([scheduledDate])
}

// Maintenance Management
model MaintenanceRequest {
  id          String            @id @default(cuid())
  tenantId    String
  roomId      String?
  reportedBy  String
  title       String
  description String
  priority    Priority          @default(MEDIUM)
  category    String
  status      MaintenanceStatus @default(REPORTED)
  assignedTo  String?
  scheduledDate DateTime?
  completedAt DateTime?
  cost        Float?
  notes       String?
  images      String[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  room        Room?             @relation(fields: [roomId], references: [id])
  reporter    User              @relation("MaintenanceReporter", fields: [reportedBy], references: [id])
  assignedUser User?            @relation("MaintenanceAssignee", fields: [assignedTo], references: [id])
  
  @@index([tenantId])
  @@index([roomId])
  @@index([status])
  @@index([priority])
}

// Service Management
model Service {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  category    String
  price       Float
  duration    Int?      // in minutes
  isActive    Boolean   @default(true)
  images      String[]
  availability Json?    // Service availability schedule
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]
  
  @@index([tenantId])
  @@index([category])
}

model ServiceOrder {
  id          String           @id @default(cuid())
  tenantId    String
  bookingId   String?
  serviceId   String
  guestId     String
  quantity    Int              @default(1)
  totalAmount Float
  status      ServiceOrderStatus @default(PENDING)
  scheduledDate DateTime?
  completedAt DateTime?
  notes       String?
  isRental        Boolean   @default(false)
  rentalItem      String?
  rentalDueAt     DateTime?
  rentalReturnedAt DateTime?
  roomId          String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  booking     Booking?         @relation(fields: [bookingId], references: [id])
  service     Service          @relation(fields: [serviceId], references: [id])
  guest       User             @relation(fields: [guestId], references: [id])
  room        Room?            @relation(fields: [roomId], references: [id])
  
  @@index([tenantId])
  @@index([bookingId])
  @@index([status])
}

// Inventory Management
model InventoryItem {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  category    String
  description String?
  sku         String?
  currentStock Int
  minStock    Int
  maxStock    Int
  unit        String    // "pieces", "liters", etc.
  unitCost    Float
  supplier    String?
  lastRestocked DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([category])
  @@index([currentStock])
}

// Financial Management
model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  bookingId   String
  amount      Float
  currency    String        @default("USD")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  transactionId String?     // POS reference / FPOS terminal ID
  notes       String?       // staff notes / channel info
  gatewayResponse Json?
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([bookingId])
  @@index([status])
}

// Reporting
model Report {
  id          String     @id @default(cuid())
  tenantId    String
  title       String
  type        ReportType
  parameters  Json?
  data        Json
  generatedBy String
  createdAt   DateTime   @default(now())

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
}

// Enums
enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  FRONT_DESK
  HOUSEKEEPING
  MAINTENANCE
  GUEST
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum RoomType {
  STANDARD
  DELUXE
  SUITE
  FAMILY
  DORMITORY
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_ORDER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum TaskType {
  CLEANING
  MAINTENANCE
  INSPECTION
  SETUP
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceOrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  DIGITAL_WALLET
  CRYPTO
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ReportType {
  OCCUPANCY
  REVENUE
  GUEST_SATISFACTION
  STAFF_PERFORMANCE
  MAINTENANCE
  INVENTORY
}

// ─── Arrival / Departure Management ───────────────────────────────────────────

model ArrivalRecord {
  id                  String        @id @default(cuid())
  tenantId            String
  bookingId           String        @unique

  // Transport
  transportType       TransportType @default(SPEEDBOAT)
  transportRef        String?       // flight no., vessel name, etc.
  transportOptionId   String?       // link to TransportOption catalog
  transportCost       Float?
  costPaid            Boolean       @default(false)

  // Pickup
  pickupBy            PickupType    @default(STAFF)
  pickupStaffId       String?
  pickupVendor        String?       // outsourced company/person name

  // Timeline milestones (stored as UTC)
  scheduledArrival    DateTime?     // when guest is expected
  departedAt          DateTime?     // departed origin (flight/boat departed)
  eta                 DateTime?     // current estimated arrival at jetty
  arrivedJettyAt      DateTime?     // arrived jetty / port
  arrivedPropertyAt   DateTime?     // arrived at property
  checkedInAt         DateTime?     // formal check-in completed

  // Arrival details
  luggageCount        Int?
  jettyTransport      String?       // e.g. "dhoni", "walk", "buggy"
  jettyTransportSeats Int?          // seats this party occupies
  jettyTransportCapacity Int?       // max capacity of the jetty vehicle
  jettyTransportOptionId String?    // link to TransportOption catalog (own boat)
  specialNotes        String?

  // Ticket / transfer confirmation
  ticketsPurchased    Boolean       @default(false)
  seatNumbers         String?       // e.g. "12A, 12B" for flights/ferries
  airportPickupConfirmed Boolean    @default(false) // someone at airport to meet guest

  // Check-in milestones
  cardIssued          Boolean       @default(false)
  welcomeDrink        Boolean       @default(false)

  // Overall pipeline status
  status              ArrivalStatus @default(SCHEDULED)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking             Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pickupStaff         User?         @relation("ArrivalPickupStaff", fields: [pickupStaffId], references: [id])
  transportOption     TransportOption? @relation("InboundTransport", fields: [transportOptionId], references: [id])
  jettyTransportOption TransportOption? @relation("JettyTransport", fields: [jettyTransportOptionId], references: [id])

  @@index([tenantId])
  @@index([status])
}

model TransportOption {
  id            String        @id @default(cuid())
  tenantId      String
  type          TransportType
  name          String        // e.g. "Maldivian MH123", "Island Ferry Hulhumale", "Sea Star Dhoni"
  operator      String?       // company / operator name
  contactName   String?       // captain / agent / coordinator
  contactPhone  String?
  contactEmail  String?
  capacity      Int?          // max passengers
  arrivalPoint  String?       // airport code / jetty name e.g. "VIA", "HDH", "Male Ferry Terminal"
  departurePoint String?      // where it departs from
  schedule      String?       // e.g. "Daily 08:00, 14:00, 18:00"
  notes         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inboundArrivals  ArrivalRecord[] @relation("InboundTransport")
  jettyArrivals    ArrivalRecord[] @relation("JettyTransport")
  departureInbound DepartureRecord[] @relation("DepartureInboundTransport")
  departureJetty   DepartureRecord[] @relation("DepartureJettyTransport")

  @@index([tenantId])
  @@index([type])
}

enum TransportType {
  DOMESTIC_FLIGHT
  SEAPLANE
  SPEEDBOAT
  CHARTER_BOAT
  FERRY
  SELF_ARRANGED
  OTHER
}

enum PickupType {
  STAFF
  OUTSOURCED
  SELF
}

enum ArrivalStatus {
  SCHEDULED
  IN_TRANSIT
  AT_JETTY
  AT_PROPERTY
  CHECKED_IN
}

enum DepartureStatus {
  SCHEDULED
  PREPARING
  AT_JETTY
  DEPARTED
}

model DepartureRecord {
  id                  String          @id @default(cuid())
  tenantId            String
  bookingId           String          @unique

  // Outbound transport
  transportType       TransportType   @default(SPEEDBOAT)
  transportRef        String?
  transportOptionId   String?
  transportCost       Float?
  costPaid            Boolean         @default(false)

  // Ticket confirmation
  ticketsPurchased    Boolean         @default(false)
  seatNumbers         String?

  // Jetty / property → port leg
  jettyTransport      String?
  jettyTransportSeats Int?
  jettyTransportCapacity Int?
  jettyTransportOptionId String?

  // Timeline milestones
  scheduledDeparture  DateTime?       // when guest should leave property
  billSettledAt       DateTime?       // bill settled
  luggageReadyAt      DateTime?       // luggage collected/ready at lobby
  leftPropertyAt      DateTime?       // guest left the property
  arrivedJettyAt      DateTime?       // arrived at departure jetty/port
  boardedAt           DateTime?       // confirmed boarded onward transport

  // Extra
  luggageCount        Int?
  specialNotes        String?

  // Status
  status              DepartureStatus @default(SCHEDULED)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking             Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transportOption     TransportOption? @relation("DepartureInboundTransport", fields: [transportOptionId], references: [id])
  jettyTransportOption TransportOption? @relation("DepartureJettyTransport", fields: [jettyTransportOptionId], references: [id])

  @@index([tenantId])
  @@index([status])
}

// @@@ Mini Bar @@@

model MinIBarItem {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  category    String
  isFree      Boolean  @default(false)
  price       Float    @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usages      MinIBarUsage[]
  @@index([tenantId])
}

model MinIBarUsage {
  id          String        @id @default(cuid())
  tenantId    String
  bookingId   String?
  roomId      String
  itemId      String
  quantity    Int           @default(1)
  isFree      Boolean       @default(false)
  amount      Float         @default(0)
  status      MinIBarStatus @default(PENDING)
  notes       String?
  recordedAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  item        MinIBarItem   @relation(fields: [itemId], references: [id])
  room        Room          @relation(fields: [roomId], references: [id])
  booking     Booking?      @relation(fields: [bookingId], references: [id])
  @@index([tenantId])
  @@index([bookingId])
  @@index([roomId])
  @@index([status])
}

enum MinIBarStatus {
  PENDING
  ON_BILL
  PAID
  WAIVED
}

// @@@ Staff additions @@@

model StaffClockRecord {
  id           String       @id @default(cuid())
  tenantId     String
  staffId      String
  clockIn      DateTime
  clockOut     DateTime?
  breakMinutes Int?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  staff        StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([staffId])
}

model StaffTask {
  id          String        @id @default(cuid())
  tenantId    String
  staffId     String?
  title       String
  description String?
  category    String?
  priority    Priority      @default(MEDIUM)
  status      TaskStatus    @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  staff       StaffProfile? @relation(fields: [staffId], references: [id])
  @@index([tenantId])
  @@index([staffId])
  @@index([status])
}

model StaffSOP {
  id          String   @id @default(cuid())
  tenantId    String
  department  String
  title       String
  description String?
  steps       Json
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenantId])
  @@index([department])
}

// @@@ Logistics @@@

model LogisticsOrder {
  id          String          @id @default(cuid())
  tenantId    String
  title       String
  description String?
  requestedBy String?
  destination String?
  status      LogisticsStatus @default(DRAFT)
  urgency     Priority        @default(MEDIUM)
  requestedAt DateTime        @default(now())
  sentAt      DateTime?
  arrivedAt   DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       LogisticsOrderItem[]
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([status])
}

model LogisticsOrderItem {
  id              String              @id @default(cuid())
  orderId         String
  inventoryItemId String?
  name            String
  quantity        Float
  unit            String              @default("pcs")
  estimatedCost   Float?
  actualCost      Float?
  notes           String?
  status          LogisticsItemStatus @default(PENDING)
  order           LogisticsOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem   LogisticsInventoryItem? @relation(fields: [inventoryItemId], references: [id])
  @@index([orderId])
  @@index([inventoryItemId])
}

model LogisticsInventoryItem {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  category     String   @default("general")
  unit         String   @default("pcs")
  description  String?
  parLevel     Float    @default(0)
  currentStock Float    @default(0)
  location     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMovements LogisticsStockMovement[]
  orderItems   LogisticsOrderItem[]
  @@index([tenantId])
}

model LogisticsStockMovement {
  id           String              @id @default(cuid())
  tenantId     String
  itemId       String
  type         StockMovementType
  quantity     Float
  balanceAfter Float               @default(0)
  notes        String?
  reference    String?
  recordedBy   String?
  recordedAt   DateTime            @default(now())
  item         LogisticsInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([itemId])
}

enum LogisticsStatus {
  DRAFT
  SENT
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum LogisticsItemStatus {
  PENDING
  SENT
  RECEIVED
  PARTIAL
}

enum StockMovementType {
  RECEIVED
  USED
  ADJUSTED
}

// @@@ Food and Beverage @@@

model FnBOutlet {
  id           String        @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  outletType   FnBOutletType @default(RESTAURANT)
  location     String?
  isActive     Boolean       @default(true)
  settings     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  menuItems    FnBMenuItem[]
  reservations FnBReservation[]
  bills        FnBBill[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
}

model FnBMenuItem {
  id              String    @id @default(cuid())
  tenantId        String
  outletId        String
  name            String
  description     String?
  category        String
  price           Float
  isActive        Boolean   @default(true)
  images          String[]
  allergens       String[]
  isVegetarian    Boolean   @default(false)
  isVegan         Boolean   @default(false)
  preparationTime Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  outlet          FnBOutlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([outletId])
  @@index([category])
}

model FnBReservation {
  id         String               @id @default(cuid())
  tenantId   String
  outletId   String
  bookingId  String?
  guestName  String
  guestPhone String?
  partySize  Int                  @default(2)
  date       DateTime
  notes      String?
  status     FnBReservationStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  outlet     FnBOutlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([outletId])
  @@index([date])
  @@index([status])
}

model FnBBill {
  id            String        @id @default(cuid())
  tenantId      String
  outletId      String
  bookingId     String?
  reservationId String?
  guestName     String?
  tableNumber   String?
  items         Json
  subtotal      Float         @default(0)
  discount      Float         @default(0)
  serviceCharge Float         @default(0)
  tax           Float         @default(0)
  totalAmount   Float         @default(0)
  paidAmount    Float         @default(0)
  status        FnBBillStatus @default(OPEN)
  paymentMethod PaymentMethod?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  outlet        FnBOutlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([outletId])
  @@index([status])
}

enum FnBOutletType {
  RESTAURANT
  BAR
  CAFE
  BEACH_BAR
  ROOM_SERVICE_OUTLET
}

enum FnBReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FnBBillStatus {
  OPEN
  CLOSED
  PAID
  VOIDED
}
