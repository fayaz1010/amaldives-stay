// ─── Notification Hub ─────────────────────────────────────────────────────────
//
// Persistent outbox for any guest- or staff-facing message. queueNotification()
// writes a row; sendPendingNotifications() (driven by /api/cron/notifications,
// added in TASK-11b) drains rows whose scheduledFor has passed. Keeping the
// queue in the DB rather than memory means retries survive cold starts and
// delivery state is auditable per booking.
model Notification {
  id           String              @id @default(cuid())
  tenantId     String
  bookingId    String?
  channel      NotificationChannel @default(EMAIL)
  type         String              // e.g. BOOKING_CONFIRMATION, ARRIVAL_REMINDER
  to           String               // email address (EMAIL) or phone (SMS/WHATSAPP)
  subject      String?
  body         String              @db.Text
  payload      Json?
  status       NotificationStatus  @default(PENDING)
  scheduledFor DateTime            @default(now())
  sentAt       DateTime?
  attempts     Int                 @default(0)
  lastError    String?             @db.Text
  providerId   String?              // Resend / SMS provider message id
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status, scheduledFor])
  @@index([bookingId])
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// ─── Guest ↔ Hotel Stay Chat (TASK-03) ────────────────────────────────────────
// Booking-scoped conversation thread, active from check-in date through
// departure day (inclusive). One conversation per booking; messages carry a
// sender role so the same thread renders correctly for guest and staff UIs.
model StayConversation {
  id        String   @id @default(cuid())
  tenantId  String
  bookingId String   @unique
  openedAt  DateTime @default(now())
  closedAt  DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages StayMessage[]

  @@index([tenantId])
}

model StayMessage {
  id             String          @id @default(cuid())
  conversationId String
  senderRole     ChatSenderRole
  senderUserId   String?
  body           String          @db.Text
  createdAt      DateTime        @default(now())
  readAt         DateTime?

  conversation StayConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?            @relation("StayMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
}

enum ChatSenderRole {
  GUEST
  STAFF
}

// ─── B2B travel agencies (TASK-02) ───────────────────────────────────────────
