
generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "windows"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Authentication and User Management
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(GUEST)
  tenantId      String?   // null for super admin, set for tenant users
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  
  // Guest-specific relations
  guestProfile  GuestProfile?
  bookings      Booking[]
  serviceOrders ServiceOrder[]
  
  // Staff-specific relations
  staffProfile  StaffProfile?
  assignedTasks HousekeepingTask[]
  reportedMaintenanceRequests MaintenanceRequest[] @relation("MaintenanceReporter")
  assignedMaintenanceRequests MaintenanceRequest[] @relation("MaintenanceAssignee")
  arrivalPickups              ArrivalRecord[]      @relation("ArrivalPickupStaff")
  stayMessages                StayMessage[]        @relation("StayMessageSender")

  // Multi-tenant membership. User.tenantId still points at the user's
  // currently-active tenant (so the entire existing query layer keeps
  // working) — `memberships` is the authoritative list of every tenant
  // this user can access.
  memberships   TenantMembership[]
  agencyUser    AgencyUser?

  @@index([tenantId])
  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Multi-tenant Core
model Tenant {
  id          String      @id @default(cuid())
  name        String
  subdomain   String      @unique
  domain      String?     @unique
  description String?
  logo        String?
  theme       Json?       // Custom branding configuration
  settings    Json?       // Tenant-specific settings
  plan        String      @default("basic")
  commissionRate Float    @default(0.04)
  isVerifiedDirect Boolean @default(false)
  amaldivesSlug String?   @unique
  // Owner opt-in: when true (and amaldivesSlug is set) this property is surfaced
  // in the "Book Direct — Verified" featured grid on amaldives.com via the public
  // /api/public/amaldives/listings endpoint. Off by default (existing tenants keep
  // their per-page book-direct widget but are not promoted until they opt in).
  amaldivesFeatured Boolean @default(false)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users       User[]
  properties  Property[]
  bookings    Booking[]
  rooms       Room[]
  services    Service[]
  staff       StaffProfile[]
  inventory   InventoryItem[]
  reports     Report[]
  arrivals    ArrivalRecord[]
  transportOptions TransportOption[]
  departures  DepartureRecord[]
  minIBarItems      MinIBarItem[]
  logisticsOrders   LogisticsOrder[]
  logisticsInventory LogisticsInventoryItem[]
  logisticsAssets   LogisticsAsset[]
  fnbOutlets        FnBOutlet[]
  expenses          Expense[]
  payrollEntries    PayrollEntry[]
  groupBookings     GroupBooking[]
  ratePlans         RatePlan[]
  externalCalendarFeeds  ExternalCalendarFeed[]
  externalCalendarBlocks ExternalCalendarBlock[]
  memberships            TenantMembership[]
  notifications          Notification[]
  promotions             Promotion[]
  stayConversations      StayConversation[]
  agencies               Agency[]
  otaEmailMessages       OtaEmailMessage[]

  @@index([subdomain])
  @@index([status])
  @@index([amaldivesFeatured])
}

/// Junction table linking Users → Tenants with a role per tenant.
/// One user can be a member of many tenants (e.g. an owner who runs
/// two guesthouses on different islands, or a manager invited to a
/// second property). The active tenant for a session is still tracked
/// via User.tenantId — switching active tenant just updates that FK.
///
/// Exactly one membership per user should carry isDefault=true; this
/// is enforced in application code (not in the DB).
model TenantMembership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      UserRole
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model Property {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  address     String
  city        String
  state       String
  country     String
  zipCode     String
  phone       String
  email       String
  website     String?
  checkInTime String   @default("15:00")
  checkOutTime String  @default("11:00")
  currency    String   @default("USD")
  timezone    String   @default("UTC")
  images      String[]
  amenities   String[]
  policies    Json?
  settings    Json?
  // Per-property MIRA / tax configuration (Maldives). All nullable + configurable
  // because rates change and each property files its OWN MIRA return (separate TIN).
  // null on a rate = fall back to the platform default in lib/tax.
  taxTin              String?  // MIRA Taxpayer Identification Number (per property)
  tgstRate            Float?   // e.g. 0.17 (TGST since 1 Jul 2025)
  greenTaxUsdPerNight Float?   // 6 (<=50 rooms guesthouse) or 12 (>50 rooms / resort)
  serviceChargeRate   Float?   // e.g. 0.10 distributed to staff
  taxSettings         Json?    // filing frequency, GST registration flags, MIRAconnect notes
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms       Room[]
  bookings    Booking[]
  promotions  Promotion[]

  @@index([tenantId])
}

// Room Management
model Room {
  id          String     @id @default(cuid())
  tenantId    String
  propertyId  String
  number      String
  name        String
  type        RoomType
  // Per-tenant custom category label (free text). Falls back to `type` when null.
  // Lets each property define its own room-type categories without touching the
  // shared RoomType enum. See tenant.settings.roomTypes for the picklist.
  typeLabel   String?
  description String?
  capacity    Int
  basePrice   Float
  // Optional published "rack" rate (a.k.a. card rate / undiscounted retail rate).
  // When null, calculateNightlyRate falls back to basePrice so existing tenants
  // see no behaviour change. When set, basePrice represents the rate we sell at
  // and rackRate is the displayed crossed-out price + the anchor that promotion
  // discounts are computed against (Promotion.appliesTo = RACK).
  rackRate    Float?
  images      String[]
  amenities   String[]
  size        Int?       // Square footage
  bedType     String?
  status      RoomStatus @default(AVAILABLE)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  housekeepingTasks HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]
  minIBarUsages MinIBarUsage[]
  serviceOrders ServiceOrder[]
  externalCalendarFeeds  ExternalCalendarFeed[]
  externalCalendarBlocks ExternalCalendarBlock[]

  @@unique([tenantId, propertyId, number])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
}

// External calendar sync — owner pastes an iCal URL exposed by their
// Booking.com / Airbnb / Vrbo listing. We poll the URL every 15 min via
// /api/cron/ical-sync and write the parsed VEVENT date ranges to
// ExternalCalendarBlock so the availability calendar and public room
// search treat those dates as unavailable.
model ExternalCalendarFeed {
  id             String   @id @default(cuid())
  tenantId       String
  roomId         String?  // null = applies to all rooms in the tenant
  label          String   // owner-supplied, e.g. "Booking.com — Deluxe Sea View"
  source         String   // BOOKING_COM | AIRBNB | VRBO | OTHER
  icalUrl        String
  isActive       Boolean  @default(true)
  lastSyncedAt   DateTime?
  lastError      String?
  lastEventCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room   Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  blocks ExternalCalendarBlock[]

  @@unique([tenantId, icalUrl])
  @@index([tenantId])
  @@index([roomId])
}

model ExternalCalendarBlock {
  id        String   @id @default(cuid())
  feedId    String
  tenantId  String
  roomId    String?
  uid       String   // iCal UID — used to upsert idempotently per feed
  summary   String?  // optional VEVENT SUMMARY ("CLOSED - Not available")
  description String? @db.Text
  guestName   String?
  guestEmail  String?
  guestPhone  String?
  startDate DateTime // inclusive (start of stay)
  endDate   DateTime // exclusive (departure date — iCal convention)
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feed   ExternalCalendarFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room   Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([feedId, uid])
  @@index([tenantId, startDate, endDate])
  @@index([roomId, startDate, endDate])
}

// OTA email ingest — audit trail + review queue for every inbound OTA
// reservation email (Booking.com/Airbnb/Agoda/Expedia/Vrbo notification
// copies). One row per email: the raw content, what the regex parser
// (lib/ota-email-parse.ts) extracted, what Gemini's independent
// verification pass (lib/ota-email-verify.ts) determined, and — once a
// staff member reviews it — the final outcome. This is both the manual
// review queue AND a ready-made labeled dataset for training a dedicated
// extraction model later, once more properties are onboarded.
enum OtaMessageStatus {
  CREATED
  UPDATED
  CANCELLED
  NEEDS_REVIEW
  REJECTED
  FAILED
}

model OtaEmailMessage {
  id            String   @id @default(cuid())
  tenantId      String?  // null if the recipient address couldn't be resolved to a tenant
  fromAddress   String
  toAddress     String
  subject       String
  rawText       String?  @db.Text
  rawHtml       String?  @db.Text
  source        String   // booking.com | airbnb | agoda | expedia | vrbo | ota
  regexResult   Json?    // ParsedOtaEmail from lib/ota-email-parse.ts, or null
  aiResult      Json?    // Gemini-reconciled struct from lib/ota-email-verify.ts
  discrepancies Json?    // fields where regex and Gemini disagreed
  confidence    Float?   // Gemini's 0-1 confidence in aiResult
  status        OtaMessageStatus
  bookingId     String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([createdAt])
  @@index([bookingId])
}

// Booking System
model Booking {
  id            String        @id @default(cuid())
  tenantId      String
  propertyId    String
  roomId        String
  guestId       String
  confirmationNumber String   @unique
  checkInDate   DateTime
  checkOutDate  DateTime
  adults        Int
  children      Int           @default(0)
  totalAmount   Float
  platformFee   Float         @default(0)
  paidAmount    Float         @default(0)
  status        BookingStatus @default(PENDING)
  source        String?       // "direct", "booking.com", etc.
  notes         String?
  specialRequests String?
  groupBookingId String?
  guestToken    String?       @unique
  stripeCheckoutSessionId String? @unique
  // Instant check-in/out QR codes (short codes encoded in guest QR / desk scanner)
  checkInCode   String?       @unique
  checkoutCode  String?       @unique
  keysIssued    Boolean       @default(false)
  checkedInAt   DateTime?
  checkoutReadyAt DateTime?
  // Set on bookings promoted from an iCal OTA feed. Value is
  // namespaced as `${feed.source}:${VEVENT.UID}` (e.g.
  // `BOOKING_COM:abcd@booking.com`) so the same raw UID coming
  // from two different OTAs can't collide. We use this as the
  // dedupe key when re-syncing a feed so a stable OTA reservation
  // becomes exactly one Booking row across syncs.
  icalUid       String?       @unique
  agencyId      String?       // B2B agent booking
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guest         User          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  groupBooking  GroupBooking? @relation(fields: [groupBookingId], references: [id])
  agency        Agency?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  
  payments      Payment[]
  serviceOrders ServiceOrder[]
  arrival       ArrivalRecord?
  departure     DepartureRecord?
  minIBarUsages MinIBarUsage[]
  staffTasks    StaffTask[]
  stayConversation StayConversation?
  otaEmailMessages OtaEmailMessage[]

  @@index([tenantId])
  @@index([confirmationNumber])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@index([status])
  @@index([groupBookingId])
  @@index([agencyId])
}

model GroupBooking {
  id        String    @id @default(cuid())
  tenantId  String
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  @@index([tenantId])
}

model RatePlan {
  id          String   @id @default(cuid())
  tenantId    String
  propertyId  String?       // null = shared across properties; set = scoped to one
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  multiplier  Float    @default(1.0)
  minStay     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([startDate, endDate])
  @@index([propertyId])
}

enum PromotionAppliesTo {
  RACK
  ALL
}

model Promotion {
  id              String             @id @default(cuid())
  tenantId        String
  propertyId      String?
  code            String?
  name            String
  description     String?
  discountPercent Float
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean            @default(true)
  appliesTo       PromotionAppliesTo @default(RACK)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId, startDate, endDate])
  @@index([propertyId])
}

// Guest Management
model GuestProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  firstName   String
  lastName    String
  phone       String?
  dateOfBirth DateTime?
  nationality String?
  address     String?
  city        String?
  state       String?
  country     String?
  zipCode     String?
  preferences Json?     // Dietary, room preferences, etc.
  loyaltyTier String?   @default("STANDARD")
  totalStays  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// Staff Management
model StaffProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  tenantId    String
  employeeId  String?
  department  String
  position    String
  permissions String[]   // Role-specific permissions
  salary      Float?
  hireDate    DateTime
  isActive    Boolean    @default(true)
  schedule    Json?      // Work schedule configuration
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clockRecords StaffClockRecord[]
  tasks       StaffTask[]
  payrollEntries PayrollEntry[]
  
  @@index([tenantId])
  @@index([userId])
}

// Housekeeping Management
model HousekeepingTask {
  id          String     @id @default(cuid())
  tenantId    String
  propertyId  String?       // per-property scoping (multi-property)
  roomId      String
  assignedTo  String?
  taskType    TaskType
  priority    Priority   @default(MEDIUM)
  description String?
  checklist   Json?      // Task checklist items
  status      TaskStatus @default(PENDING)
  scheduledDate DateTime
  completedAt DateTime?
  estimatedDuration Int? // in minutes
  actualDuration Int?   // in minutes
  notes       String?
  autoGenerated Boolean  @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  room        Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedUser User?     @relation(fields: [assignedTo], references: [id])
  
  @@index([tenantId])
  @@index([roomId])
  @@index([assignedTo])
  @@index([status])
  @@index([scheduledDate])
  @@index([propertyId])
}

// Maintenance Management
model MaintenanceRequest {
  id          String            @id @default(cuid())
  tenantId    String
  propertyId  String?       // per-property scoping (multi-property)
  roomId      String?
  reportedBy  String
  title       String
  description String
  priority    Priority          @default(MEDIUM)
  category    String
  status      MaintenanceStatus @default(REPORTED)
  assignedTo  String?
  scheduledDate DateTime?
  completedAt DateTime?
  cost        Float?
  notes       String?
  images      String[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  room        Room?             @relation(fields: [roomId], references: [id])
  reporter    User              @relation("MaintenanceReporter", fields: [reportedBy], references: [id])
  assignedUser User?            @relation("MaintenanceAssignee", fields: [assignedTo], references: [id])
  
  @@index([tenantId])
  @@index([roomId])
  @@index([status])
  @@index([priority])
  @@index([propertyId])
}

// Service Management
model Service {
  id          String    @id @default(cuid())
  tenantId    String
  propertyId  String?       // null = shared across properties; set = scoped to one
  name        String
  description String?
  category    String
  price       Float
  duration    Int?      // in minutes
  isActive    Boolean   @default(true)
  images      String[]
  availability Json?    // Service availability schedule
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]
  
  @@index([tenantId])
  @@index([category])
  @@index([propertyId])
}

model ServiceOrder {
  id          String           @id @default(cuid())
  tenantId    String
  propertyId  String?       // per-property scoping (multi-property)
  bookingId   String?
  serviceId   String
  guestId     String
  quantity    Int              @default(1)
  totalAmount Float
  status      ServiceOrderStatus @default(PENDING)
  scheduledDate DateTime?
  completedAt DateTime?
  notes       String?
  isRental        Boolean   @default(false)
  rentalItem      String?
  rentalDueAt     DateTime?
  rentalReturnedAt DateTime?
  roomId          String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  booking     Booking?         @relation(fields: [bookingId], references: [id])
  service     Service          @relation(fields: [serviceId], references: [id])
  guest       User             @relation(fields: [guestId], references: [id])
  room        Room?            @relation(fields: [roomId], references: [id])
  
  @@index([tenantId])
  @@index([bookingId])
  @@index([status])
  @@index([propertyId])
}

// Inventory Management
model InventoryItem {
  id          String    @id @default(cuid())
  tenantId    String
  propertyId  String?       // null = shared across properties; set = scoped to one
  name        String
  category    String
  description String?
  sku         String?
  currentStock Int
  minStock    Int
  maxStock    Int
  unit        String    // "pieces", "liters", etc.
  unitCost    Float
  supplier    String?
  lastRestocked DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([category])
  @@index([currentStock])
  @@index([propertyId])
}

// Financial Management
model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  propertyId  String?       // denormalised from booking for per-property revenue/MIRA
  bookingId   String
  amount      Float
  currency    String        @default("USD")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  transactionId String?     // POS reference / FPOS terminal ID
  notes       String?       // staff notes / channel info
  gatewayResponse Json?
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId])
  @@index([bookingId])
  @@index([status])
}

// Reporting
model Report {
  id          String     @id @default(cuid())
  tenantId    String
  propertyId  String?    // null = consolidated (all properties); set = single-property report
  title       String
  type        ReportType
  parameters  Json?
  data        Json
  generatedBy String
  createdAt   DateTime   @default(now())

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId])
  @@index([type])
  @@index([createdAt])
}

// Enums
enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  FRONT_DESK
  HOUSEKEEPING
  MAINTENANCE
  TRAVEL_AGENT
  GUEST
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum RoomType {
  STANDARD
  DELUXE
  SUITE
  FAMILY
  DORMITORY
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_ORDER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum TaskType {
  CLEANING
  TURNOVER
  LAUNDRY
  DEEP_CLEAN
  MAINTENANCE
  INSPECTION
  SETUP
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceOrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  DIGITAL_WALLET
  CRYPTO
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ReportType {
  OCCUPANCY
  REVENUE
  GUEST_SATISFACTION
  STAFF_PERFORMANCE
  MAINTENANCE
  INVENTORY
}

// ─── Arrival / Departure Management ───────────────────────────────────────────

model ArrivalRecord {
  id                  String        @id @default(cuid())
  tenantId            String
  propertyId  String?       // per-property scoping (multi-property)
  bookingId           String        @unique

  // Transport
  transportType       TransportType @default(SPEEDBOAT)
  transportRef        String?       // flight no., vessel name, etc.
  transportOptionId   String?       // link to TransportOption catalog
  transportCost       Float?
  costPaid            Boolean       @default(false)

  // Pickup
  pickupBy            PickupType    @default(STAFF)
  pickupStaffId       String?
  pickupVendor        String?       // outsourced company/person name

  // Timeline milestones (stored as UTC)
  scheduledArrival    DateTime?     // when guest is expected
  departedAt          DateTime?     // departed origin (flight/boat departed)
  eta                 DateTime?     // current estimated arrival at jetty
  arrivedJettyAt      DateTime?     // arrived jetty / port
  arrivedPropertyAt   DateTime?     // arrived at property
  checkedInAt         DateTime?     // formal check-in completed

  // Arrival details
  luggageCount        Int?
  jettyTransport      String?       // e.g. "dhoni", "walk", "buggy"
  jettyTransportSeats Int?          // seats this party occupies
  jettyTransportCapacity Int?       // max capacity of the jetty vehicle
  jettyTransportOptionId String?    // link to TransportOption catalog (own boat)
  specialNotes        String?

  // Ticket / transfer confirmation
  ticketsPurchased    Boolean       @default(false)
  seatNumbers         String?       // e.g. "12A, 12B" for flights/ferries
  airportPickupConfirmed Boolean    @default(false) // someone at airport to meet guest

  // Check-in milestones
  cardIssued          Boolean       @default(false)
  welcomeDrink        Boolean       @default(false)

  // Overall pipeline status
  status              ArrivalStatus @default(SCHEDULED)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking             Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pickupStaff         User?         @relation("ArrivalPickupStaff", fields: [pickupStaffId], references: [id])
  transportOption     TransportOption? @relation("InboundTransport", fields: [transportOptionId], references: [id])
  jettyTransportOption TransportOption? @relation("JettyTransport", fields: [jettyTransportOptionId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([propertyId])
}

model TransportOption {
  id            String        @id @default(cuid())
  tenantId      String
  propertyId  String?       // null = shared across properties; set = scoped to one
  type          TransportType
  name          String        // e.g. "Maldivian MH123", "Island Ferry Hulhumale", "Sea Star Dhoni"
  operator      String?       // company / operator name
  contactName   String?       // captain / agent / coordinator
  contactPhone  String?
  contactEmail  String?
  capacity      Int?          // max passengers
  arrivalPoint  String?       // airport code / jetty name e.g. "VIA", "HDH", "Male Ferry Terminal"
  departurePoint String?      // where it departs from
  schedule      String?       // e.g. "Daily 08:00, 14:00, 18:00"
  notes         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inboundArrivals  ArrivalRecord[] @relation("InboundTransport")
  jettyArrivals    ArrivalRecord[] @relation("JettyTransport")
  departureInbound DepartureRecord[] @relation("DepartureInboundTransport")
  departureJetty   DepartureRecord[] @relation("DepartureJettyTransport")

  @@index([tenantId])
  @@index([type])
  @@index([propertyId])
}

enum TransportType {
  DOMESTIC_FLIGHT
  SEAPLANE
  SPEEDBOAT
  CHARTER_BOAT
  FERRY
  SELF_ARRANGED
  OTHER
}

enum PickupType {
  STAFF
  OUTSOURCED
  SELF
}

enum ArrivalStatus {
  SCHEDULED
  IN_TRANSIT
  AT_JETTY
  AT_PROPERTY
  CHECKED_IN
}

enum DepartureStatus {
  SCHEDULED
  PREPARING
  AT_JETTY
  DEPARTED
}

model DepartureRecord {
  id                  String          @id @default(cuid())
  tenantId            String
  propertyId  String?       // per-property scoping (multi-property)
  bookingId           String          @unique

  // Outbound transport
  transportType       TransportType   @default(SPEEDBOAT)
  transportRef        String?
  transportOptionId   String?
  transportCost       Float?
  costPaid            Boolean         @default(false)

  // Ticket confirmation
  ticketsPurchased    Boolean         @default(false)
  seatNumbers         String?

  // Jetty / property → port leg
  jettyTransport      String?
  jettyTransportSeats Int?
  jettyTransportCapacity Int?
  jettyTransportOptionId String?

  // Timeline milestones
  scheduledDeparture  DateTime?       // when guest should leave property
  billSettledAt       DateTime?       // bill settled
  luggageReadyAt      DateTime?       // luggage collected/ready at lobby
  leftPropertyAt      DateTime?       // guest left the property
  arrivedJettyAt      DateTime?       // arrived at departure jetty/port
  boardedAt           DateTime?       // confirmed boarded onward transport

  // Extra
  luggageCount        Int?
  specialNotes        String?

  // Status
  status              DepartureStatus @default(SCHEDULED)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking             Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transportOption     TransportOption? @relation("DepartureInboundTransport", fields: [transportOptionId], references: [id])
  jettyTransportOption TransportOption? @relation("DepartureJettyTransport", fields: [jettyTransportOptionId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([propertyId])
}

