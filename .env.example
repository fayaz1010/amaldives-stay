# PostgreSQL connection string (Neon recommended: https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth
NEXTAUTH_URL="https://stay.amaldives.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# amaldives.com Neon DB (read-only, for seeding)
AMALDIVES_DATABASE_URL=""

# Stripe — direct booking checkout + subscriptions
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_BUSINESS=""
STRIPE_PRICE_CHANNEL=""

# Gemini — OTA guest detail extraction from iCal (optional if UTIL_AI is set)
GEMINI_API_KEY=""
UTIL_AI_URL=""
UTIL_AI_TOKEN=""

# Vercel Domains API — attach guesthouses' own domains to this project
# (multi-tenant custom domains). Token needs access to the project's team.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
