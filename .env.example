# PostgreSQL connection string (Neon recommended: https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth
NEXTAUTH_URL="https://stay.amaldives.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# amaldives.com Neon DB (read-only, for seeding)
AMALDIVES_DATABASE_URL=""

# Stripe — direct booking checkout + subscriptions
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_BUSINESS=""
STRIPE_PRICE_CHANNEL=""
STRIPE_PRICE_WEB=""

# Gemini — OTA guest detail extraction from iCal + OTA email verification
# (optional if UTIL_AI is set; UTIL_AI is tried first, this is the local-dev fallback)
GEMINI_API_KEY=""
UTIL_AI_URL=""
UTIL_AI_TOKEN=""

# Vercel Domains API — attach guesthouses' own domains to this project
# (multi-tenant custom domains). Token needs access to the project's team.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# WhatsApp number for the /for-guesthouses landing CTAs (intl format, no "+").
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# OTA email ingest (cloudflare/ota-email-worker forwards here). Shared secret
# must match the Worker's OTA_INGEST_SECRET. Domain is the zone the Worker's
# Email Routing catch-all is bound to, e.g. "amaldives.com" — used to build
# the self-serve "ota-<subdomain>@<domain>" address shown in /admin/web?tab=channels.
OTA_INGEST_SECRET=""
OTA_INGEST_DOMAIN=""

# Resend — outbound transactional email (booking confirmations, staff alerts,
# OTA review-queue notifications)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Vercel Cron — Bearer auth for /api/cron/* routes
CRON_SECRET=""
